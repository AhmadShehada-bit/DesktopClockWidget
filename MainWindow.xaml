<Window x:Class="DesktopClockWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopClockWidget"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        MouseDown="Window_MouseDown">
    <Window.Resources>
        <FontFamily x:Key="RajdhaniFont">pack://application:,,,/Fonts/#Rajdhani</FontFamily>
    </Window.Resources>
    <Grid x:Name="RootGrid" Margin="20">
        <StackPanel x:Name="ContentStack" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- ✦ Symbol -->
            <TextBlock x:Name="SymbolTop"
                       Text="✦"
                       FontFamily="Rajdhani"
                       FontWeight="Light"
                       FontSize="16"
                       Foreground="#D1CFCC"
                       Opacity="0.82"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,0,0,8" />

            <!-- GOOD NIGHT -->
            <TextBlock x:Name="GreetingText"
                       Text="GOOD NIGHT"
                       FontFamily="Rajdhani"
                       FontWeight="Regular"
                       FontSize="20"
                       Foreground="#D1CFCC"
                       Opacity="0.92"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,0,0,16"
                       LetterSpacing="40" />

            <!-- Weekday (Hero) -->
            <TextBlock x:Name="WeekdayText"
                       Text="SAT"
                       FontFamily="Rajdhani"
                       FontWeight="Medium"
                       FontSize="64"
                       Foreground="#D1CFCC"
                       Opacity="0.94"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,0,0,16"
                       LetterSpacing="80" />

            <!-- Date and Time -->
            <StackPanel x:Name="DateTimeStack" HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock x:Name="DateText"
                           Text="29 AUG"
                           FontFamily="Rajdhani"
                           FontWeight="Regular"
                           FontSize="18"
                           Foreground="#D1CFCC"
                           Opacity="0.85"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,0,0,4"
                           LetterSpacing="40" />
                <TextBlock x:Name="TimeText"
                           Text="12:06 PM"
                           FontFamily="Rajdhani"
                           FontWeight="Regular"
                           FontSize="18"
                           Foreground="#D1CFCC"
                           Opacity="0.85"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           LetterSpacing="40" />
            </StackPanel>

            <!-- ⌁ Symbol -->
            <TextBlock x:Name="SymbolBottom"
                       Text="⌁"
                       FontFamily="Rajdhani"
                       FontWeight="Light"
                       FontSize="16"
                       Foreground="#D1CFCC"
                       Opacity="0.82"
                       HorizontalAlignment="Center"
                       TextAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>